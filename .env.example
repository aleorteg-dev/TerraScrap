# TerraScrap — environment variables
# Copy to .env and adjust. .env is gitignored.

# Maximum upload size accepted by backend (and nginx client_max_body_size is set to 250 MB)
TWI_MAX_UPLOAD_MB=200

# World session TTL in seconds (30 min default)
TWI_WORLD_TTL_SECONDS=1800

# Absolute path inside the backend container for the items JSON cache
TWI_ITEM_CACHE_PATH=/app/data/items.json

# Allowed CORS origins as JSON array. Empty = closed (production default).
# Dev: ["http://localhost:5173"]
TWI_CORS_ORIGINS=[]

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
TWI_LOG_LEVEL=INFO

# Host port mapped to nginx (container always listens on 80)
PORT=8080
